# 依赖
node_modules/

# 编译输出
dist/
desktop/dist/

# 数据目录（LanceDB 文件、上传文件、会话、记忆等运行时数据）
data/*
!data/.gitkeep
!data/config.example.json
!data/supervisor-config.example.json
!data/skills/
# skills 目录仅提交模板「创建技能.md」，其余为用户/会话自定义技能
data/skills/*
!data/skills/创建技能.md

# 项目级本地配置（MCP、memory.md 等），不提交
.iceCoder/
.cursor/

# Pipeline 输出
output/

# 环境变量
.env
.env.*

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*

# 二进制工具
bin/

# 单元测试 / 覆盖率产物（test/ 源码目录保留提交）
__test_*
coverage/
test/tmp-tool-diffs/
test/tmp-tool-diffs-fsop/
test/tmp-tool-diffs-ws/

# 运行时遥测与本地评测缓存（仅仓库根目录；src/runtime 源码需入库）
/runtime/
data/eval/

# LoCoMo / Benchmark 证据：LoCoMo/、benchMark/reports/ 纳入版本库；仅忽略本地跑分中间目录
docs/locomo/
benchMark/repos/
benchMark/score/

# 用户记忆（开发时可能落在仓库根目录或 data/user-memory/）
user-memory/
MEMORY.md

# 脚本生成的验证报告
scripts/verification_report.md

# Python 缓存
__pycache__/
*.py[cod]

# Electron 桌面构建产物
desktop/server-bundle/
desktop/release/
desktop/.cache/
desktop/package-lock.json
desktop/pnpm-lock.yaml

# 构建产物 / 包（npm pack 输出不入库）
*.tgz

# 统一使用 npm（根目录 .npmrc + package-lock.json）；忽略根级 pnpm 锁文件避免双包管理器
/pnpm-lock.yaml

# curl/调试残留
cookies.txt

# Electron 临时目录
desktop/_electron_tmp/

# 公开发布安装包纳入版本库：releases/windows/*.exe
